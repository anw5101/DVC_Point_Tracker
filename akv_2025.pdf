	<script data-no-minify="1">
		jQuery(document).ready(function($) {

			function formatNumbersWithDecimalsAndCommas(element, appendText='') {
				let rawValue = element.textContent.replace(/,/g, ''); // Remove existing commas
				// console.log(rawValue);
				let numericValue = parseFloat(rawValue);
				// console.log(numericValue);

				if (!isNaN(numericValue)) { // Check if valid
					let formattedPrice;
					
					if (Number.isInteger(numericValue)) {
						formattedPrice = numericValue.toLocaleString('en-US', {
							maximumFractionDigits: 0
						});
					}
					else {
						formattedPrice = numericValue.toLocaleString('en-US', {
							minimumFractionDigits: 2,
							maximumFractionDigits: 2
						});
					}
					element.textContent = '$'+formattedPrice+appendText; // Formats with commas and pre-pended dollar sign
				}
			}

			function formatNumbers(selector, appendText) {
				document.querySelectorAll(selector).forEach(element => {
					formatNumbersWithDecimalsAndCommas(element, appendText);
				});
			}

			// trigger formatNumbers on page load
			formatNumbers('.listings-table-filters .filter-container .price .bpfwe-custom-field-wrapper ul.taxonomy-filter span', '');
			formatNumbers('.listings-table-filters .filter-container .price_per_point .bpfwe-custom-field-wrapper ul.taxonomy-filter span', '/pt.');
			formatNumbers('.number-price .elementor-heading-title', '');

			// Trigger formatting after AJAX filtering completes using jQuery's ajaxComplete ---
            $(document).ajaxComplete(function(event, xhr, settings) {
                formatNumbers('.listings-table-filters .filter-container .price .bpfwe-custom-field-wrapper ul.taxonomy-filter span', '');
				formatNumbers('.listings-table-filters .filter-container .price_per_point .bpfwe-custom-field-wrapper ul.taxonomy-filter span', '/pt.');
				formatNumbers('.number-price .elementor-heading-title', '');
            });


		});
	</script>
			<script data-no-minify="1">
		jQuery(document).ready(function($) {
			/**
			 * Intialize jQuery UI slider with inputs from plugin's range filter for min and max inputs.
			 * Need to use a jQuery range slider to have lider with min and max handles.
			 * On change, we want to update the plugin's range filter's min/max inputs with the range slider's input so when Apply Filters is clicked, it automatically modifies the query based on the range. We are just adding another input an syncing it with the existing range inputs.
			 */
			function initializeRangeSlider(minInputName, maxInputName, sliderStep) {
				
				var minInputField = $('input[name="' + minInputName + '"]');
        		var maxInputField = $('input[name="' + maxInputName + '"]');
				var rangeInputWrapper  = minInputField.closest('.bpfwe-numeric-wrapper'); // used to place slider within this filter dropdown


				if (!minInputField.length || !maxInputField.length || !rangeInputWrapper.length) {
					return; // exit if inputs are not found.
				}

				// Get minimum and maximum. Get current Values
				var minRange = parseInt(minInputField.attr('data-base-min'));
				var maxRange = parseInt(maxInputField.attr('data-base-max'));
				var initialMin = parseInt(minInputField.val()) || minRange;
				var initialMax = parseInt(maxInputField.val()) || maxRange;

				
				var sliderId = minInputName.replace('min_', '') + '-range-slider'; // #points-range-slider
				var sliderHtml = `<div id="${sliderId}"></div>`;

				// Insert the slider track just above the inputs
        		rangeInputWrapper.append(sliderHtml);
				// select the new slider we just inserted
				var rangeSlider = $('#' + sliderId);

				// Initialize the jQuery UI Slider
				// https://jqueryui.com/slider/#range. https://api.jqueryui.com/slider/ 
				rangeSlider.slider({
					range: true,
					min: minRange,
					max: maxRange,
					step: sliderStep, 
					values: [initialMin, initialMax],
					
					slide: function(event, ui) {
						// Update the plugin's field inputs *as* the slider moves.
						minInputField.val(ui.values[0]);
						maxInputField.val(ui.values[1]);
					},

					stop: function(event, ui) {
						// Relying on the 'Apply Filters' button click to submit the form.
					}
				});


				// Update Slider if User manually types into MIN input
				minInputField.on('change keyup', function() {
					// get value from minInputField
					var newMin = parseInt($(this).val());
					// if min input value is a number and within the range  (greater than minInputField's initial value and less than Slider's initialMax)
					if (!isNaN(newMin) && newMin >= minRange && newMin <= rangeSlider.slider("values", 1)) { 
						rangeSlider.slider("values", 0, newMin); // Set the value for the min in slider values
					}
				});

				// Update Slider if User manually types into MAX input
				maxInputField.on('change keyup', function() {
					// get value from minInputField
					var newMax = parseInt($(this).val());
					// if min input value is a number and within the range  (less than maxInputField's initial value and greater than Slider's initialMin)
					if (!isNaN(newMax) && newMax <= maxRange && newMax >= rangeSlider.slider("values", 0)) { 
						rangeSlider.slider("values", 1, newMax); // Set the value for the min in slider values
					}
				});

			}

			// Points range
			// Price range
			// Price per point range
			initializeRangeSlider('min_points', 'max_points', 1);
			initializeRangeSlider('min_price', 'max_price', 1);
			initializeRangeSlider('min_price_per_point', 'max_price_per_point', 1);
			initializeRangeSlider('min_transfer_points', 'max_transfer_points', 1);
			initializeRangeSlider('min_total_price', 'max_total_price', 1);

			/**
			 * Reset range slider values to the original min and max, reset when Clear Filters button is clicked.
			 */
			function resetRangeSlider(minInputName, maxInputName) {
				var minInputField = $('input[name="' + minInputName + '"]');
        		var maxInputField = $('input[name="' + maxInputName + '"]');
				var sliderId = minInputName.replace('min_', '') + '-range-slider';
        		var rangeSlider = $('#' + sliderId);

				if (!rangeSlider.length) {
					return;
				}

				// Get the original range min/max
				var minRange = parseInt(minInputField.attr('data-base-min'));
				var maxRange = parseInt(maxInputField.attr('data-base-max'));

				// Reset the slider handles back to the overall bounds [min, max]
        		// This visually moves the handles on the track.
        		rangeSlider.slider("values", [minRange, maxRange]);

				// Reset the plugin input's for min and max. This is already handled by the plugin: 
				// after the plugin update: clicking Clear Filters messes up the values of the input fields, until the slider is touched then it resets. We wat to force it to reset
				// minInputField.val(minRange).attr('data-base-value', minRange);
    			// maxInputField.val(maxRange).attr('data-base-value', maxRange); 
				// minInputField.val(minRange);
        		// maxInputField.val(maxRange);
				// minInputField.attr('min', minRange);
    			// maxInputField.attr('max', maxRange);
				minInputField.val(minRange).attr('value', minRange).attr('data-base-value', minRange);
    			maxInputField.val(maxRange).attr('value', maxRange).attr('data-base-value', maxRange);
				minInputField.trigger('change');
    			maxInputField.trigger('change');
				// the plugin does not respect this. after clicking Clear Filters, it changes data-base-value and value to global numbers intead of the original numbers for min and max.
			}


			var clearFiltersButton = $('button.reset-form'); 
			// clearFiltersButton.on('click', function(e) {
			// 	setTimeout(function() { 
					
			// 		resetRangeSlider('min_points', 'max_points');
			// 		resetRangeSlider('min_price', 'max_price');
			// 		resetRangeSlider('min_price_per_point', 'max_price_per_point');
			// 		resetRangeSlider('min_transfer_points', 'max_transfer_points');
			// 		resetRangeSlider('min_total_price', 'max_total_price');

			// 		

			// 		// If the clear button triggers a form submission, may need a slight delay here.
			// 	}, 50); 
			// });

			// since filter plugin sets the minmax inputs' data-base-value and value to NONSENSE (global min max values), just reload the page instead
			clearFiltersButton.on('click', function(e) {
				// STOP the plugin's broken JS immediately
				e.preventDefault();
				e.stopPropagation();

				var cleanUrl = window.location.origin + window.location.pathname + '#filters';
				// FORCE the refresh. 
				// We use a tiny timeout just to ensure the browser registers the click before the redirect happens.
				setTimeout(function() { 
					window.location.href = cleanUrl;
					
					// Optional: If the browser is being stubborn about the cache, 
					// this forces a true reload from the server.
					window.location.reload(); 
				}, 10); 
			});




		});
		</script>
			<script data-no-minify="1">
		document.addEventListener('DOMContentLoaded', function() {

			let quickDeselectFiltersContainer;
			if (document.querySelector('body.tax-resort.archive')) {
				// run the following code for tabs on the resort archive page
				quickDeselectFiltersContainer = document.querySelector('.quick-deselect-5c6f4e8 .elementor-heading-title');
			}
			else if (document.querySelector('body.page-id-1244')) {
				// run the following code on the All Listings page,
				quickDeselectFiltersContainer = document.querySelector('.quick-deselect-088bb0b .elementor-heading-title');
			}
			else if (document.querySelector('body.page-id-27412')) {
				// run the following code on the Prebooked Reservations page,
				quickDeselectFiltersContainer = document.querySelector('.quick-deselect-5d8842a .elementor-heading-title');
			}
			else if (document.querySelector('body.page-id-27421')) {
				// run the following code on the Point Transfers page,
				quickDeselectFiltersContainer = document.querySelector('.quick-deselect-61b6f59 .elementor-heading-title');
			}
			else {
				return; // if not the resort archive and if not the all listings page, exit.
			}

			// after a filter is selected and apply filters is clicked, then the quickDeselectFiltersContainer populates with the selected terms with an 'x' to unselect that filter term
			// use event delegation instead to have fewer event listeners. 
			// We listen for clicks on the parent element (the deselect container that wraps the term pills that each contain an x button)
			// https://www.freecodecamp.org/news/event-delegation-javascript/ 
			const applyFiltersBtn = document.querySelector('.filter-container button.submit-form');
			quickDeselectFiltersContainer.addEventListener('click', function(event) {
				const deselectXBtn = event.target.closest('.bpfwe-term-remove'); // find the related x button is whichever item was clicked within the deselect container
				if (deselectXBtn) {
					setTimeout(() => {
						applyFiltersBtn.click();
					}, 50);
				}
			});
			
		});
	</script>
    <script data-no-minify="1">
        jQuery(document).ready(function($) {

            // let quickDeselectFiltersContainer;
            if ($('body.tax-resort.archive').length) {
                // run the following code for tabs on the resort archive page
            }
            else if ($('body.page-id-1244').length) {
                // run the following code on the All Listings page,
            }
            else if ($('body.page-id-27412').length) {
                // run the following code on the Prebooked Reservations page,
            }
            else if ($('body.page-id-27421').length) {
                // run the following code on the Point Transfers page,
            }
            else {
                return; // if not the resort archive and if not the all listings page, exit.
            }

            var selectedRangeFiltersOutput_price = document.querySelector('.selected-range-filters.price .elementor-heading-title');
            var selectedRangeFiltersOutput_priceperpoint = document.querySelector('.selected-range-filters.price_per_point .elementor-heading-title');
            var selectedRangeFiltersOutput_points = document.querySelector('.selected-range-filters.points .elementor-heading-title');
            var selectedRangeFiltersOutput_totalprice = document.querySelector('.selected-range-filters.total_price .elementor-heading-title');
            var selectedRangeFiltersOutput_transferpoints = document.querySelector('.selected-range-filters.transfer_points .elementor-heading-title');


            var wrapperSelectedRangeFiltersOutput_price = document.querySelector('.selected-range-filters.price');
            var wrapperSelectedRangeFiltersOutput_priceperpoint = document.querySelector('.selected-range-filters.price_per_point');
            var wrapperSelectedRangeFiltersOutput_points = document.querySelector('.selected-range-filters.points');
            var wrapperSelectedRangeFiltersOutput_totalprice = document.querySelector('.selected-range-filters.total_price');
            var wrapperSelectedRangeFiltersOutput_transferpoints = document.querySelector('.selected-range-filters.transfer_points');

            /**
             * Get min and max values from input ranges. If they are the same as the original (no filter applied), then return null, else return [min, max]
             */
            function getMinMaxValuesFromNumericRanges(minInputName, maxInputName) {
                var minInputField = $('input[name="' + minInputName + '"]');
                var maxInputField = $('input[name="' + maxInputName + '"]');

                if (!minInputField.length || !maxInputField.length) {
                    return null; // exit if inputs are not found.
                }

                // Get minimum and maximum. Get current Values
                var minRange = parseInt(minInputField.attr('min'));
                var maxRange = parseInt(maxInputField.attr('max'));
                var initialMin = parseInt(minInputField.val()) || minRange;
                var initialMax = parseInt(maxInputField.val()) || maxRange;

                // if min and max values are the absolute min and max, then do not show
                if (minRange == initialMin && maxRange == initialMax) {
                    return null;
                }
                else {
                    return [initialMin, initialMax];
                }
            }

            /**
             * Reset input values for numeric ranges
             */
            function resetInputRange(minInputName, maxInputName) {
                var minInputField = $('input[name="' + minInputName + '"]');
                var maxInputField = $('input[name="' + maxInputName + '"]');
                
                if (minInputField.length && maxInputField.length) {
                    var minRange = minInputField.attr('min');
                    var maxRange = maxInputField.attr('max');
                    
                    // trigger change to update jquery ui sliders
                    minInputField.val(minRange).trigger('change');
                    maxInputField.val(maxRange).trigger('change');
                }
            }

            /**
             * Clear outputs
             */
            function clearRangeFiltersOutput(rangeFiltersOutput, wrapperRangeFiltersOutput) {
                if(rangeFiltersOutput) {
					rangeFiltersOutput.innerHTML = "";
				}
                if(wrapperRangeFiltersOutput) {
					wrapperRangeFiltersOutput.style.display = 'none';
				}
            }

            /**
             * Attach click listneners for x buttons to reset the filter, reset the input, and clear the output
             */
            function addClearFilterListenerForNumericRanges(rangeFiltersOutput, wrapperRangeFiltersOutput, filterName) {
                // Remove any previous listener before finding the new element
                $(rangeFiltersOutput).off('click', '.clear-range-filter');
                // Attach listener to the 'x' button inside the current output element
                $(rangeFiltersOutput).on('click', '.clear-range-filter', function(e) {
                    e.preventDefault();
                    // reset filter field inputs
                    resetInputRange(`min_${filterName}`, `max_${filterName}`);
                    // clear filter outputs
                    clearRangeFiltersOutput(rangeFiltersOutput, wrapperRangeFiltersOutput);

                    // apply filters by simulating a click
                    document.querySelector('.filter-container button.submit-form').click();
                });
            }

            /* When apply filters button is clicked, we want to check the numeric ranges, if they are different from default, then get the min/max selected and display. */
            const applyFiltersBtn = document.querySelector('.filter-container button.submit-form');
            applyFiltersBtn.addEventListener('click', function() {
                
                // --- PRICE ---
                var selectedPriceMinMax = getMinMaxValuesFromNumericRanges('min_price', 'max_price');
                if (selectedPriceMinMax && selectedRangeFiltersOutput_price) {
                    selectedRangeFiltersOutput_price.innerHTML = "<span> <a href='#' class='clear-range-filter' data-filter-type='price'>×</a> Price: $" + selectedPriceMinMax[0].toLocaleString() + " - $" + selectedPriceMinMax[1].toLocaleString() + " </span>";
                    wrapperSelectedRangeFiltersOutput_price.style.display = 'inline-block';
                    addClearFilterListenerForNumericRanges(selectedRangeFiltersOutput_price, wrapperSelectedRangeFiltersOutput_price, 'price');
                }
                else {
                    clearRangeFiltersOutput(selectedRangeFiltersOutput_price, wrapperSelectedRangeFiltersOutput_price);
                }

                // --- PRICE PER POINT ---
                var selectedPricePerPointMinMax = getMinMaxValuesFromNumericRanges('min_price_per_point', 'max_price_per_point');
                if (selectedPricePerPointMinMax && selectedRangeFiltersOutput_priceperpoint) {
                    selectedRangeFiltersOutput_priceperpoint.innerHTML = "<span> <a href='#' class='clear-range-filter' data-filter-type='price_per_point'>×</a> Price per point: $" + selectedPricePerPointMinMax[0].toLocaleString() + " - $" + selectedPricePerPointMinMax[1].toLocaleString() + "</span>";
                    wrapperSelectedRangeFiltersOutput_priceperpoint.style.display = 'inline-block';
                    addClearFilterListenerForNumericRanges(selectedRangeFiltersOutput_priceperpoint, wrapperSelectedRangeFiltersOutput_priceperpoint, 'price_per_point');
                }
                else {
                    clearRangeFiltersOutput(selectedRangeFiltersOutput_priceperpoint, wrapperSelectedRangeFiltersOutput_priceperpoint);
                }

                // --- POINTS ---
                var selectedPointsMinMax = getMinMaxValuesFromNumericRanges('min_points', 'max_points');
                if (selectedPointsMinMax && selectedRangeFiltersOutput_points) {
                    selectedRangeFiltersOutput_points.innerHTML = "<span> <a href='#' class='clear-range-filter' data-filter-type='points'>×</a> Points: " + selectedPointsMinMax[0].toLocaleString() + " - " + selectedPointsMinMax[1].toLocaleString() + " </span>";
                    wrapperSelectedRangeFiltersOutput_points.style.display = 'inline-block';
                    addClearFilterListenerForNumericRanges(selectedRangeFiltersOutput_points, wrapperSelectedRangeFiltersOutput_points, 'points');
                }
                else {
                    clearRangeFiltersOutput(selectedRangeFiltersOutput_points, wrapperSelectedRangeFiltersOutput_points);
                }

                // --- TOTAL PRICE (Point Transfers) ---
                var selectedTotalPriceMinMax = getMinMaxValuesFromNumericRanges('min_total_price', 'max_total_price');
                if (selectedTotalPriceMinMax && selectedRangeFiltersOutput_totalprice) {
                    selectedRangeFiltersOutput_totalprice.innerHTML = "<span> <a href='#' class='clear-range-filter' data-filter-type='total_price'>×</a> Total Price: $" + selectedTotalPriceMinMax[0].toLocaleString() + " - $" + selectedTotalPriceMinMax[1].toLocaleString() + " </span>";
                    wrapperSelectedRangeFiltersOutput_totalprice.style.display = 'inline-block';
                    addClearFilterListenerForNumericRanges(selectedRangeFiltersOutput_totalprice, wrapperSelectedRangeFiltersOutput_totalprice, 'total_price');
                }
                else {
                    clearRangeFiltersOutput(selectedRangeFiltersOutput_totalprice, wrapperSelectedRangeFiltersOutput_totalprice);
                }

                // --- TRANSFER POINTS (Point Transfers) ---
                var selectedTransferPointsMinMax = getMinMaxValuesFromNumericRanges('min_transfer_points', 'max_transfer_points');
                if (selectedTransferPointsMinMax && selectedRangeFiltersOutput_transferpoints) {
                    selectedRangeFiltersOutput_transferpoints.innerHTML = "<span> <a href='#' class='clear-range-filter' data-filter-type='transfer_points'>×</a> Transfer Points: " + selectedTransferPointsMinMax[0].toLocaleString() + " - " + selectedTransferPointsMinMax[1].toLocaleString() + " </span>";
                    wrapperSelectedRangeFiltersOutput_transferpoints.style.display = 'inline-block';
                    addClearFilterListenerForNumericRanges(selectedRangeFiltersOutput_transferpoints, wrapperSelectedRangeFiltersOutput_transferpoints, 'transfer_points');
                }
                else {
                    clearRangeFiltersOutput(selectedRangeFiltersOutput_transferpoints, wrapperSelectedRangeFiltersOutput_transferpoints);
                }

            });

            const clearFiltersBtn = document.querySelector('.filter-container button.reset-form');
            clearFiltersBtn.addEventListener('click', function() {
                clearRangeFiltersOutput(selectedRangeFiltersOutput_price, wrapperSelectedRangeFiltersOutput_price);
                clearRangeFiltersOutput(selectedRangeFiltersOutput_priceperpoint, wrapperSelectedRangeFiltersOutput_priceperpoint);
                clearRangeFiltersOutput(selectedRangeFiltersOutput_points, wrapperSelectedRangeFiltersOutput_points);
                
                clearRangeFiltersOutput(selectedRangeFiltersOutput_totalprice, wrapperSelectedRangeFiltersOutput_totalprice);
                clearRangeFiltersOutput(selectedRangeFiltersOutput_transferpoints, wrapperSelectedRangeFiltersOutput_transferpoints);
            });

        });
    </script>
    <script data-no-minify="1">
        jQuery(document).ready(function($) {
            
            if (!$('body.page-id-27412').length > 0 && !$('body.page-id-27421').length > 0) {
				// only run the following code on the Prebooked Reservations or Point transfers page,
                return;
            }

            /**
             * Formats date values from inputs to be human-readable
			 * format input = '2026-03-08' from <input type="date">.val()
			 * output = Mar 8, 2026
             */
            function formatBrowserDate(inputDateVal) {
                if (!inputDateVal) {
					return '';
				}
                const dateObj = new Date(inputDateVal + 'T00:00:00');
                return dateObj.toLocaleDateString('en-US', { 
                    month: 'short', 
                    day: 'numeric', 
                    year: 'numeric' 
                });
            }

            /**
             * Clears the display bubble of selectedTerms
             */
            function clearDisplay(output, wrapper) {
                if (output) {
					output.innerHTML = "";
				}
                if (wrapper) {
					wrapper.style.display = 'none';
				}
            }

            /**
             * Process a specific date field
			 * 1. Get the date input's value
			 * 2. Create a display bubble with a label, date (formatted from input value)
			 * 3. Display bubble's x can be clicked to clear, which also resets the input and clicks the Apply button 
             */
            function processDateField(fieldKey, label, inputSelector, outputSelector, wrapperSelector) {
                var $input = $(inputSelector);
                var output = document.querySelector(outputSelector + ' .elementor-heading-title');
                var wrapper = document.querySelector(wrapperSelector);

                if (!$input.length || !output || !wrapper) return;

                var val = $input.val();

                if (val && val !== "") {
                    var displayDate = formatBrowserDate(val);
                    output.innerHTML = "<span> <a href='#' class='clear-date-filter' data-field='" + fieldKey + "'>×</a> " + label + ": " + displayDate + " </span>";
                    wrapper.style.display = 'inline-block';

                    // Clear button listener
                    $(output).off('click', '.clear-date-filter').on('click', '.clear-date-filter', function(e) {
                        e.preventDefault();
                        $input.val('').trigger('change');
                        clearDisplay(output, wrapper);
                        $('.filter-container button.submit-form').click();
                    });
                } else {
                    clearDisplay(output, wrapper);
                }
            }

            //  When Apply Filters button is clicked, process the date fields by passing in the labels, input ids, and output bubble containers.
			// 
            const applyFiltersBtn = document.querySelector('.filter-container button.submit-form');
            if (applyFiltersBtn) {
                applyFiltersBtn.addEventListener('click', function() {
                    
                    // Handle Prebooked Reservation DATE Fields
                    processDateField('checkin', 'Check-in', 'input#input-text-check_in-5d8842a', '.selected-date-filters.checkin', '.selected-date-filters.checkin');
                    processDateField('checkout', 'Check-out', 'input#input-text-check_out-5d8842a', '.selected-date-filters.checkout', '.selected-date-filters.checkout');

                    // Handle Point TransferS DATE Fields
                    processDateField('bank_by', 'Bank By', 'input#input-text-bank_by-61b6f59', '.selected-date-filters.bankby', '.selected-date-filters.bankby');
                    processDateField('use_by', 'Use By', 'input#input-text-use_by-61b6f59', '.selected-date-filters.useby', '.selected-date-filters.useby');
                });
            }

            // When Clear Filters button is clicked, clear bubble display. The plugin automatically resets the inputs.
            const clearFiltersBtn = document.querySelector('.filter-container button.reset-form');
            if (clearFiltersBtn) {
                clearFiltersBtn.addEventListener('click', function() {
                    $('.selected-date-filters').hide().find('.elementor-heading-title').html('');
                });
            }
        });
    </script>
	<script data-no-minify="1">
		jQuery(function ($) {

			if (!$('body.tax-resort.archive').length && !$('body.page-id-1244').length) {
				// only run the following code for tabs on the resort archive page, else exit
				return;
			}

			var urlParams = new URLSearchParams(window.location.search);

			var maxAttempts = 10;
        	var attempt = 0;

			// heading for title when pre-filtering or pre-sorting (example: "Small Point Contracts" when using ?max_points=140)
			var prefilterHeading = document.querySelector('#prefilterHeading .elementor-heading-title');

			// Usage: /resort/aulani/?sort_new=true
			// this changes the sort to be by date_listed desc
			var newSortParam = urlParams.get('sort_new');

			if (newSortParam !== null) {

				function trySetNewSort() {
					// sort listings by date desc
					var $sortSelectInput = $('.elementor-widget-sorting-widget select');

					if ($sortSelectInput.length) {
						// Option: <option data-order="DESC" data-meta="" value="date">Sort by date listed (latest)</option>
						// New Option: <option data-order="DESC" data-meta="date_listed" value="meta_value_num">Sort by date listed (latest)</option>
						
						// Set the <select> value
						$sortSelectInput.val('meta_value_num');
						// Select the correct option based on its attributes
						$sortSelectInput.find('option:selected').removeAttr('selected');
						$sortSelectInput.find('option[data-meta="date_listed"][data-order="DESC"]').prop('selected', true);
						// Manually update the data attributes on the select to confirm the choice
						$sortSelectInput.attr('data-order', 'DESC');
						$sortSelectInput.attr('data-meta', 'date_listed');
						// Trigger change to apply sorting
						$sortSelectInput.trigger('change');

						return true;
					} 
					else if (attempt < maxAttempts) {
						attempt++;
						setTimeout(trySetNewSort, 200);
					}
				}

				setTimeout(trySetNewSort, 300);

				prefilterHeading.textContent = 'New Listings';

				return;


			}


			// Usage: /resort/aulani/?banked_points=true
			// this changes the sort to be meta_value_num by banked_points desc
			var bankedPointsSortParam = urlParams.get('banked_points');

			if (bankedPointsSortParam !== null) {

				function trySetBankedPointsSort() {
					// sort listings by date desc
					var $sortSelectInput = $('.elementor-widget-sorting-widget select');

					if ($sortSelectInput.length) {
						// Option: <option data-order="DESC" data-meta="current_banked" value="meta_value_num">Sort by banked points (high to low)</option>>
						
						// Set the <select> value
						$sortSelectInput.val('meta_value_num');
						// Select the correct option based on its attributes
						$sortSelectInput.find('option:selected').removeAttr('selected');
						$sortSelectInput.find('option[data-meta="current_banked"][data-order="DESC"]').prop('selected', true);
						// Manually update the data attributes on the select to confirm the choice
						$sortSelectInput.attr('data-order', 'DESC');
						$sortSelectInput.attr('data-meta', 'current_banked');
						// Trigger change to apply sorting
						$sortSelectInput.trigger('change');

						return true;
					} 
					else if (attempt < maxAttempts) {
						attempt++;
						setTimeout(trySetBankedPointsSort, 200);
					}
				}

				setTimeout(trySetBankedPointsSort, 300);

				prefilterHeading.textContent = 'Banked Points Packages';

				return;


			}


			


			// flag variables used for max_points and min_points to check if filter and sort have been activated.
			var filterSuccess = false;
			var sortSuccess = false;

			
			// Usage: /resort/aulani/?max_points=80. Used to filter and sort for small point packages
			// this will set the max_points input to 80 and change the sort to be orderby meta_value_num points asc
        	var maxPointsValue = urlParams.get('max_points');

			// Exit if the ?max_points parameter is missing or not a valid number
			if (maxPointsValue !== null && !isNaN(maxPointsValue)) {
				
				// reset attempts counter
				maxAttempts = 10;
				attempt = 0;
				// reset attempt flags
				filterSuccess = false;
				sortSuccess = false;

				// Initial delay to wait for Elementor/plugin to load before selecting filters and sort with javascript
				setTimeout(trySetRangeInputAndSortByPoints, 300, 'max_points', maxPointsValue);

				// after successful filter and sort change, update a heading element to denote Small Point Contracts
				prefilterHeading.textContent = 'Small Point Contracts';
				
				return;
			}

			var minPointsValue = urlParams.get('min_points');

			// Exit if the ?min_points parameter is missing or not a valid number
			if (minPointsValue !== null && !isNaN(minPointsValue)) {
				
				// reset attempts counter
				maxAttempts = 10;
				attempt = 0;
				// reset attempt flags
				filterSuccess = false;
				sortSuccess = false;

				// Initial delay to wait for Elementor/plugin to load before selecting filters and sort with javascript
				setTimeout(trySetRangeInputAndSortByPoints, 300, 'min_points', minPointsValue);

				prefilterHeading.textContent = 'Average Size Contracts';
				
				return;
			}

			/**
			 * Function to pre-filter listings by setting the points filter input to a param value, then display the selected filter
			 */
			function trySetRangeInputAndSortByPoints(rangeInputName, rangeInputValueFromParam) {

				// filter max_points in numeric input range filter
				// get the max points input field
				var $rangeInputField = $('input[name="'+rangeInputName+'"]'); 
				if ($rangeInputField.length) {
					// Set the input value
					$rangeInputField.val(rangeInputValueFromParam);

					// Trigger the change/input events to simulate user interaction and apply the filter
					$rangeInputField.trigger('change'); // this causes the slider to update with this max value.
					var applyFiltersButton = $('button.submit-form'); // click apply filters to update listings table with selecte filter.
					applyFiltersButton.trigger('click');
					// Success flag to stop retries
					filterSuccess = true;
					// return true;
				}

				// sort listings by points (low to high)
				var $sortSelectInput = $('.elementor-widget-sorting-widget select');
				if ($sortSelectInput.length) {
					// <option data-order="ASC" data-meta="points" value="meta_value_num">Sort by points (low to high)</option>
					// set <select> value to meta_value_num for the sort field type
					$sortSelectInput.val('meta_value_num');
					// set the data attributes on the <select> field to be the option to sort by points asc
					$sortSelectInput.find('option:selected').removeAttr('selected');
					$sortSelectInput.find('option[data-meta="points"][data-order="ASC"]').prop('selected', true);
					// manually update data attributes on select to confirm the choice
					$sortSelectInput.attr('data-order', 'ASC');
					$sortSelectInput.attr('data-meta', 'points');
					// trigger a change event to submit
					$sortSelectInput.trigger('change');
					sortSuccess = true;
				}

				
				if ( (filterSuccess && sortSuccess) || attempt >= maxAttempts ) {

					// display points range if successful.
					var selectedRangeFiltersOutput_points = document.querySelector('.selected-range-filters.points .elementor-heading-title');
					var wrapperSelectedRangeFiltersOutput_points = document.querySelector('.selected-range-filters.points');

					if (rangeInputName === 'max_points') {
						// if filtering by max_points, display "min - value"
						selectedRangeFiltersOutput_points.innerHTML = "<span>Points: " + $rangeInputField.attr('min').toLocaleString() + " - " + rangeInputValueFromParam.toLocaleString() + "</span>";
					}
					else if (rangeInputName === 'min_points') {
						// if filtering by min_points, display "value - max"
						selectedRangeFiltersOutput_points.innerHTML = "<span>Points: " + rangeInputValueFromParam.toLocaleString() + " - " + $rangeInputField.attr('max').toLocaleString() + "</span>";
					}
					
					wrapperSelectedRangeFiltersOutput_points.style.display = 'inline-block';

					return true;
				}
				else {
					// Retry if the input element hasn't loaded yet
					attempt++;
					setTimeout(trySetRangeInputAndSortByPoints, 200, rangeInputName, rangeInputValueFromParam);
				}
			}

			
		});

	</script>


	<script data-no-minify="1">
		jQuery(document).ready(function($) {

			if (!document.querySelector('body.page-id-27412') && !document.querySelector('body.page-id-27421') ) {
				// only run the following code on PreBooked Reservations or point transfers page, else exit
				return;
			}

			const today = new Date().toISOString().split('T')[0];
			function forceDateInput(input_id_selector_string) {
				// change <input type="text"> to <input type="date"> for calendar date selection
				if ($(input_id_selector_string).length > 0) {
					// browser store input date as yyyy-mm-dd whereas acf raw stores dates for searching in the database as yyyymmdd. See convertDateFormatForFilterInput() for conversion.
					$(input_id_selector_string).attr('type', 'date'); 
					$(input_id_selector_string).attr('min', today); // prevent entering past dates
				}
				
			}
			forceDateInput('input#input-text-check_in-5d8842a'); // prebooked reservation check-in
			forceDateInput('input#input-text-check_out-5d8842a'); // prebooked reservation check-out
			forceDateInput('input#input-text-bank_by-61b6f59'); // point transfer banking deadline
			forceDateInput('input#input-text-use_by-61b6f59'); // point tranfer if banked use by deadline
		});

	</script>


	<script data-no-minify="1">
		document.addEventListener('DOMContentLoaded', function() {

			if (!document.querySelector('body.tax-resort.archive') && !document.querySelector('body.page-id-1244') && !document.querySelector('body.page-id-27412') && !document.querySelector('body.page-id-27421')) {
				// only run the following code for tabs on the resort archive page, all listings page, prebooked reservations, point transfers, else exit
				return;
			}

			function closeFiltersAccordion () {
				if (window.matchMedia('(max-width: 768px)').matches) {
					// Select all accordion items
					var accordionItems = document.querySelectorAll('.listings-table-filters-accordion .e-n-accordion-item');

					// Loop through each accordion item
					accordionItems.forEach(function(item) {
						// Close the accordion item
						// item.removeAttribute('open'); // this causes an abrupt close, which is fine on page load but not fine when apply or clear buttons are clicked
						
						if (item.hasAttribute('open')) {
							const summary = item.querySelector('.listings-table-filters-accordion .e-n-accordion-item-title');
							// Programmatically click the summary to trigger the Elementor animation
							if (summary) {
								summary.click();
							}
						}
						
					});
				}
			}
			closeFiltersAccordion();
			

			const clearFiltersBtn = document.querySelector('.filter-container button.reset-form');
			clearFiltersBtn.addEventListener('click', function() {
				closeFiltersAccordion();
			}); 
			const applyFiltersBtn = document.querySelector('.filter-container button.submit-form');
			applyFiltersBtn.addEventListener('click', function() {
				closeFiltersAccordion();
			});
		});

	</script>



