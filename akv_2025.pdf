	<script data-no-minify="1">
	document.addEventListener('DOMContentLoaded', function() {

	if (!document.querySelector('body.tax-resort.archive') && !document.querySelector('body.single-resale-listing') && !document.querySelector('body.single-prebookedreservation') && !document.querySelector('body.single-pointrentaltransfers')) {
		// only run the following code for tabs on the resort archive page or on single resale listing page, else if neither then exit
		return;
	}

    // Select all tab links and content panes within any rooms-tabs-container
    const tabContainers_rooms = document.querySelectorAll('.rooms-tabs-container');

    tabContainers_rooms.forEach(tabContainer_rooms => {
        const tabLinks_rooms = tabContainer_rooms.querySelectorAll('.rooms-tab-link');
        const tabPanes_rooms = tabContainer_rooms.querySelectorAll('.rooms-tab-pane');

        tabLinks_rooms.forEach(link => {
            link.addEventListener('click', function() {
                // Remove 'active-room' class from all tab links and from all tab content panes
                tabLinks_rooms.forEach(tabLink_room => {
                    tabLink_room.classList.remove('active-room');
                    tabLink_room.setAttribute('aria-selected', 'false'); 
                });
                tabPanes_rooms.forEach(tabPane_room => tabPane_room.classList.remove('active-room'));

                // Activate the clicked tab link
                this.classList.add('active-room');
                this.setAttribute('aria-selected', 'true'); 

                // Find the target content pane using the data-target attribute
                const targetId_room = this.dataset.target;
                const targetPane_room = tabContainer_rooms.querySelector(targetId_room);

                // Activate the target content pane based on the clicked tab link's data-target-id
                if (targetPane_room) {
                    targetPane_room.classList.add('active-room');
                }
            });
        });
	});
	});
</script>
	
	<script data-no-minify="1">
	document.addEventListener('DOMContentLoaded', function() {

	if (!document.querySelector('body.tax-resort.archive')) {
		// only run the following code for tabs on the resort archive page, else exit
		return;
	}

    // Select all tab links and content panes within any rooms-tabs-container
    const tabContainers_restaurants = document.querySelectorAll('.restaurants-tabs-container');

    tabContainers_restaurants.forEach(tabContainer_restaurant => {
        const tabLinks_restaurants = tabContainer_restaurant.querySelectorAll('.restaurant-tab-link');
        const tabPanes_restaurants = tabContainer_restaurant.querySelectorAll('.restaurant-tab-pane');

        tabLinks_restaurants.forEach(link => {
            link.addEventListener('click', function() {
                // Remove 'active-restaurant' class from all tab links and from all tab content panes
                tabLinks_restaurants.forEach(tabLink_restaurant => {
                    tabLink_restaurant.classList.remove('active-restaurant');
                    tabLink_restaurant.setAttribute('aria-selected', 'false'); 
                });
                tabPanes_restaurants.forEach(tabPane_restaurant => tabPane_restaurant.classList.remove('active-restaurant'));

                // Activate the clicked tab link
                this.classList.add('active-restaurant');
                this.setAttribute('aria-selected', 'true'); 

                // Find the target content pane using the data-target attribute
                const targetId_restaurant = this.dataset.target;
                const targetPane_restaurant = tabContainer_restaurant.querySelector(targetId_restaurant);

                // Activate the target content pane based on the clicked tab link's data-target-id
                if (targetPane_restaurant) {
                    targetPane_restaurant.classList.add('active-restaurant');
                }
            });
        });
	});
	});
</script>
	
