<script id="kv-consent-bridge">(function(){
  function setConsent(state){
    if(!state)return;
    var tier=1;
    if(state.advertising)tier=3;
    else if(state.analytics)tier=2;
    document.cookie='_kv_consent='+tier+';path=/;max-age=31536000;SameSite=Lax';
  }
  function trySync(){
    if(window.Termly&&typeof window.Termly.getConsentState==='function'){
      setConsent(window.Termly.getConsentState());
      try{window.Termly.on('consent',function(){setConsent(window.Termly.getConsentState());});}catch(e){}
      return true;
    }
    return false;
  }
  if(!trySync()){
    var attempts=0;
    var poll=setInterval(function(){
      if(trySync()||++attempts>50){clearInterval(poll);}
    },200);
  }
  var origOnLoad=window.onTermlyLoaded;
  window.onTermlyLoaded=function(){
    if(typeof origOnLoad==='function')origOnLoad();
    trySync();
  };
  window.addEventListener('termly:consent',function(){trySync();});
})();</script><script id="kv-link-decorator">(function(){
  var owned=[
    'unlockedmagic.com','dvcrentalstore.com','dvcresalemarket.com',
    'beourguestvacations.com','worldofdvc.com','monerafinancial.com',
    'magicvacationtitle.com','keyholdervacations.com','dvcfan.com'
  ];
  function getCookie(n){
    var m=document.cookie.match(new RegExp('(?:^|; )'+n+'=([^;]*)'));
    return m?m[1]:null;
  }
  function isOwned(h){
    h=h.toLowerCase().replace(/^www\./,'');
    for(var i=0;i<owned.length;i++){if(owned[i]===h)return true;}
    return false;
  }
  document.addEventListener('click',function(e){
    var a=e.target.closest('a');
    if(!a||!a.href)return;
    try{
      var u=new URL(a.href);
      if(u.hostname===location.hostname)return;
      if(!isOwned(u.hostname.replace(/^www\./,'')))return;
      var c=getCookie('_kv_consent');if(!c||parseInt(c,10)<2)return;
      var vid=getCookie('_kv_vid');
      if(!vid)return;
      if(u.searchParams.has('_kvid'))return;
      u.searchParams.set('_kvid',vid);
      a.href=u.toString();
    }catch(ex){}
  },true);
})();</script><script id="jquery-migrate-js" src="https://c0.wp.com/c/7.0.2/wp-includes/js/jquery/jquery-migrate.min.js"></script><script id="jetpack-mu-wpcom-settings-js-before">
